# Optional: copy to .env to change ports or secrets. Every value has a default.
# The passwords, the JWT secret and the internal key below are dev-only values: never use them in production.

POSTGRES_HOST_PORT=5432
GATEWAY_HOST_PORT=8080
FRONTEND_HOST_PORT=4200
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025
PROMETHEUS_HOST_PORT=9090

POSTGRES_PASSWORD=postgres
AUTH_DB_PASSWORD=auth_pass
LEDGER_DB_PASSWORD=ledger_pass
BANKING_DB_PASSWORD=banking_pass

JWT_SECRET=dev-only-jwt-secret-change-me-it-must-be-32-bytes-or-more

INTERNAL_API_KEY=dev-internal-key-change-me
